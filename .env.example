# Google Cloud / Argolis Vertex AI Configuration (Uses IAM ADC — no hardcoded keys)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Secret Manager ID for Gemini API Key when not using Vertex AI ADC
GEMINI_API_KEY_SECRET_ID=gemini-api-key

# Optional: Enable Google Cloud Sensitive Data Protection (DLP API) in addition to local regex PII scrubbing
ENABLE_CLOUD_DLP=FALSE

# Persistent Storage Directory (SQLite session + style preference vector memory)
THRILLED_DATA_DIR=.thrilled_data

# Strategic Model Routing
THRILLED_PRO_MODEL=gemini-4-hydrogen
THRILLED_FLASH_MODEL=gemini-4-hydrogen
